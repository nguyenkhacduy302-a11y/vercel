// --- COMPONENT: AI CHATBOT WIDGET ---
const AIChatbot = () => {
  const [isOpen, setIsOpen] = useState(false);
  const [messages, setMessages] = useState([
    { role: 'bot', content: 'Xin chào! Tôi là Trợ lý ảo Di sản Khánh Hòa. Bạn muốn tìm hiểu về Tháp Bà Ponagar, Thành Diên Khánh hay ẩm thực địa phương?' }
  ]);
  const [input, setInput] = useState('');
  const [isTyping, setIsTyping] = useState(false);
  const messagesEndRef = useRef(null);

  const scrollToBottom = () => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  };

  useEffect(() => {
    scrollToBottom();
  }, [messages, isOpen]);

  const handleSend = () => {
    if (!input.trim()) return;
    
    const userMsg = { role: 'user', content: input };
    setMessages(prev => [...prev, userMsg]);
    setInput('');
    setIsTyping(true);

    // Giả lập AI trả lời
    setTimeout(() => {
      let botResponse = "Cảm ơn bạn đã đặt câu hỏi. Hệ thống đang tra cứu dữ liệu số hóa...";
      if (input.toLowerCase().includes('tháp bà')) {
        botResponse = "Tháp Bà Ponagar là quần thể kiến trúc Chăm Pa lớn nhất Việt Nam hiện nay, nằm tại cửa sông Cái, Nha Trang. Bạn có muốn xem hình ảnh 360 độ không?";
      } else if (input.toLowerCase().includes('vé') || input.toLowerCase().includes('giá')) {
        botResponse = "Hiện tại giá vé tham quan Tháp Bà là 30.000 VNĐ/khách. Miễn phí cho người dân địa phương vào ngày lễ Chăm.";
      }

      setMessages(prev => [...prev, { role: 'bot', content: botResponse }]);
      setIsTyping(false);
    }, 1500);
  };

  return (
    <div className="fixed bottom-6 right-6 z-50 flex flex-col items-end">
      {/* Cửa sổ chat */}
      {isOpen && (
        <div className="bg-white w-[90vw] md:w-96 h-[500px] shadow-2xl rounded-2xl flex flex-col overflow-hidden border border-gray-200 mb-4 animate-in slide-in-from-bottom-5 duration-300">
          {/* Header */}
          <div className="bg-gradient-to-r from-[#003B5C] to-[#005f73] p-4 flex justify-between items-center text-white shadow-md">
            <div className="flex items-center gap-3">
              <div className="relative">
                <div className="w-10 h-10 bg-white rounded-full flex items-center justify-center text-[#003B5C]">
                  <Sparkles size={20} />
                </div>
                <span className="absolute bottom-0 right-0 w-3 h-3 bg-green-400 border-2 border-[#003B5C] rounded-full"></span>
              </div>
              <div>
                <h3 className="font-bold text-sm">Trợ lý Di sản AI</h3>
                <p className="text-[10px] opacity-80">Luôn sẵn sàng hỗ trợ</p>
              </div>
            </div>
            <button onClick={() => setIsOpen(false)} className="hover:bg-white/20 p-1 rounded-full transition">
              <X size={20} />
            </button>
          </div>

          {/* Nội dung chat */}
          <div className="flex-1 p-4 overflow-y-auto bg-gray-50 space-y-4">
            {messages.map((msg, idx) => (
              <div key={idx} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                {msg.role === 'bot' && (
                  <div className="w-8 h-8 rounded-full bg-[#003B5C] flex items-center justify-center text-white mr-2 flex-shrink-0 mt-1">
                    <Sparkles size={14} />
                  </div>
                )}
                <div className={`max-w-[80%] p-3 rounded-2xl text-sm leading-relaxed shadow-sm ${
                  msg.role === 'user' 
                    ? 'bg-[#003B5C] text-white rounded-tr-none' 
                    : 'bg-white border border-gray-200 text-gray-800 rounded-tl-none'
                }`}>
                  {msg.content}
                </div>
              </div>
            ))}
            {isTyping && (
              <div className="flex justify-start">
                 <div className="w-8 h-8 rounded-full bg-[#003B5C] flex items-center justify-center text-white mr-2 flex-shrink-0">
                    <Sparkles size={14} />
                  </div>
                  <div className="bg-white border border-gray-200 p-3 rounded-2xl rounded-tl-none text-gray-500 text-xs italic">
                    Đang nhập...
                  </div>
              </div>
            )}
            <div ref={messagesEndRef} />
          </div>

          {/* Input Area */}
          <div className="p-3 bg-white border-t flex gap-2 items-center">
            <input 
              type="text" 
              value={input}
              onChange={(e) => setInput(e.target.value)}
              onKeyPress={(e) => e.key === 'Enter' && handleSend()}
              placeholder="Hỏi về lịch sử, địa điểm..."
              className="flex-1 text-sm bg-gray-100 border-transparent focus:bg-white border focus:border-[#003B5C] rounded-full px-4 py-3 focus:outline-none transition"
            />
            <button 
              onClick={handleSend} 
              disabled={!input.trim()}
              className="bg-[#D4AF37] text-[#003B5C] p-3 rounded-full hover:bg-[#b89628] transition disabled:opacity-50 disabled:cursor-not-allowed shadow-md"
            >
              <Send size={18} />
            </button>
          </div>
        </div>
      )}

      {/* Nút mở Chatbot */}
      {!isOpen && (
        <button 
          onClick={() => setIsOpen(true)}
          className="group flex items-center justify-center bg-[#003B5C] hover:bg-[#004e7a] text-white p-4 rounded-full shadow-2xl transition-all hover:scale-110 relative"
        >
          <MessageSquare size={28} />
          <span className="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full animate-pulse"></span>
          
          {/* Tooltip */}
          <span className="absolute right-full mr-4 bg-white text-[#003B5C] px-3 py-1 rounded-lg text-sm font-bold shadow-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
            Hỏi đáp AI ngay!
          </span>
        </button>
      )}
    </div>
  );
};

